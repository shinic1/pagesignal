{
  "name": "pagesignal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "deploy": "npm run deploy:worker && npm run deploy:site",
    "deploy:worker": "npm run build && vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:site": "wrangler pages deploy cloudflare-pages --project-name pagesignal --branch main",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=11.6.2"
  },
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@vapi-ai/web": "^2.5.2",
    "@vinext/cloudflare": "^1.0.0-beta.4",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "oxlint": "^1.75.0",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "postcss": "8.5.21",
    "sharp": "0.35.3"
  }
}
